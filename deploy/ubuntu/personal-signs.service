[Unit]
Description=Personal ISL sign recognition server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=personal-signs
Group=personal-signs
EnvironmentFile=/etc/personal-signs/personal-signs.env
# Localhost only: the Cloudflare Tunnel is the only way in from the internet.
# --proxy-headers lets the server see each visitor's real address via the tunnel.
ExecStart=/opt/personal-signs/.venv/bin/python -m personal_signs serve --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=5

# The service can only write to its own data folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-signs

[Install]
WantedBy=multi-user.target
