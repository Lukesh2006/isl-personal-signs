# install.sh copies this to /etc/personal-signs/personal-signs.env.

# Recordings, trained models and reports
PERSONAL_SIGNS_DATA_DIR=/var/lib/personal-signs/data
# MediaPipe .task files (downloaded by install.sh)
PERSONAL_SIGNS_MODELS_DIR=/var/lib/personal-signs/models

# Accounts: this project's own PocketBase (install.sh sets the port).
# Every API call must send the user's PocketBase login token.
POCKETBASE_URL=http://127.0.0.1:8091
# The address browsers use to sign up / log in (through the Cloudflare Tunnel).
POCKETBASE_PUBLIC_URL=https://db.signbridgeco.xyz

# Readable copy of every saved clip: <name>/<sign>/<sign>_sample_01.webm (empty = off)
PERSONAL_SIGNS_TEAM_CLIPS_DIR=/var/lib/personal-signs/team-clips

# Only used when POCKETBASE_URL is empty: a single shared key instead of accounts.
PERSONAL_SIGNS_API_KEY=
