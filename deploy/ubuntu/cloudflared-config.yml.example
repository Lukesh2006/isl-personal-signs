# Hostnames this project needs in a Cloudflare Tunnel. Guide: docs/self-hosting-ubuntu.md, step 3.
#
# If this machine ALREADY runs cloudflared for another project, do not replace its
# config: add just the two "hostname" entries below to its existing ingress list
# (above its final "- service: http_status:404" line) and restart cloudflared.
#
# For a new tunnel: copy to /etc/cloudflared/config.yml and replace TUNNEL_ID (twice).
tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

ingress:
  # Recognition engine + its page
  - hostname: signs.signbridgeco.xyz
    service: http://127.0.0.1:8000
  # This project's PocketBase (sign up / log in, admin dashboard at /_/)
  - hostname: db.signbridgeco.xyz
    service: http://127.0.0.1:8091
  - service: http_status:404
