[Unit]
Description=Cloudflare Tunnel for Personal ISL Signs (its own tunnel and program, separate from any other)
After=network-online.target personal-signs.service
Wants=network-online.target

[Service]
Type=simple
User=personal-signs
Group=personal-signs
# TUNNEL_TOKEN=... (written by setup-tunnel.sh, readable only by root and this service)
EnvironmentFile=/etc/personal-signs/tunnel.env
# Our own cloudflared copy, and an EMPTY --config file on purpose: it must never pick up
# another project's default config. Hostnames are set in the Cloudflare dashboard.
ExecStart=/opt/personal-signs-tunnel/cloudflared --config /etc/personal-signs/cloudflared.yml --no-autoupdate tunnel run
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Hides /home and /root (so ~/.cloudflared of any user is invisible) ...
ProtectHome=true
# ... and the machine-wide cloudflared settings of any other project.
InaccessiblePaths=-/etc/cloudflared -/usr/local/etc/cloudflared

[Install]
WantedBy=multi-user.target
